# Supabase (Auth + Waitlist)
# Dashboard: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY...
SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY...

# Afiliado (opcional). Se NEXT_PUBLIC_AFFILIATE_URL nao for definida, o CTA
# "Abrir conta numa corretora" abre um modal com varias corretoras publicas.
# NEXT_PUBLIC_AFFILIATE_URL=https://www.btgpactual.com/abrir-conta?utm=fiibrasil
# NEXT_PUBLIC_AFFILIATE_LABEL=Abrir conta no BTG Pactual

# URL publica do site (usada em canonical, sitemap, OpenGraph).
# Em producao, defina para o seu dominio final.
# NEXT_PUBLIC_SITE_URL=https://fiibrasil.vercel.app

# Google Search Console (opcional). Cole AQUI somente o codigo do metodo
# "Tag HTML" (o valor do content="..."), nao a tag inteira. Depois de definir
# e fazer deploy, clique em "Verificar" no Search Console.
# GOOGLE_SITE_VERIFICATION=abc123def456...
